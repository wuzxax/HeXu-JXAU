<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/agenda_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/agenda_widget_bg" android:padding="10dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:id="@+id/agenda_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="下一项安排" android:textColor="#b6d6c0" android:textSize="10sp"/><TextView android:id="@+id/agenda_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#b6d6c0" android:textSize="10sp"/></LinearLayout>
 <TextView android:id="@+id/agenda_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="打开禾序同步课表" android:textColor="#ffffff" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/agenda_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#c4dcc7" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/agenda_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#b6d6c0" android:textSize="10sp"/>
 <LinearLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <Chronometer android:id="@+id/agenda_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#d9edc1" android:textSize="10sp"/>
 
</LinearLayout>